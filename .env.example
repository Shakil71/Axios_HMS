# Copy to .env — never commit real values.

NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# Database / cache
DATABASE_URL=postgresql://hms_app:change-me@localhost:5432/hms?schema=public
REDIS_URL=redis://localhost:6379

# Auth (generate with: openssl rand -base64 48)
JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=14

# Field-level encryption for NID/passport numbers (32-byte base64 key; rotate via key id)
FIELD_ENCRYPTION_KEY=
FIELD_ENCRYPTION_KEY_ID=v1

# S3-compatible private object storage
STORAGE_DRIVER=s3
# Server-side encryption header: AES256 | aws:kms | none (MinIO without KMS => none)
S3_SSE=AES256
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=hms-private-documents
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true
SIGNED_URL_TTL_SECONDS=120

# Upload limits
UPLOAD_MAX_BYTES=15728640

# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Axios Station Medical Care <no-reply@example.com>"

# Bot protection (Cloudflare Turnstile)
CAPTCHA_SECRET_KEY=

RATE_LIMIT_ENABLED=true
