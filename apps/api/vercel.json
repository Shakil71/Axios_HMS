{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd ../.. && npm ci -w @hms/api --include-workspace-root=false",
  "buildCommand": "node scripts/vercel-build.cjs",
  "outputDirectory": "public",
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }],
  "functions": { "api/index.js": { "maxDuration": 30, "includeFiles": "{dist,prisma}/**" } }
}
